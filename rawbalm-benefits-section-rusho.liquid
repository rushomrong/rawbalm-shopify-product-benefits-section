<style>
  /* Product header */
  .rb-product-header {
    margin-bottom: 6px;
    font-family: inherit;
  }

  .rb-rating-row {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 8px;
  }

  .rb-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .rb-rating-text {
    font-size: 12.5px;
    color: #3a5a47;
    font-weight: 500;
  }

  .rb-product-title {
    font-size: 26px;
    font-weight: 700;
    color: #1a3c2e;
    line-height: 1.2;
    margin: 0 0 10px;
    letter-spacing: -0.3px;
  }

  .rb-product-desc {
    font-size: 14px;
    color: #4a6358;
    line-height: 1.6;
    margin: 0 0 18px;
  }

  /* Benefits card */
  .rb-benefits-wrap {
    border: 1.5px solid #d4e6d0;
    border-radius: 12px;
    padding: 18px 20px 16px;
    margin: 20px 0;
    background: #f8fcf7;
    font-family: inherit;
  }

  /* Benefits grid — 2 columns */
  .rb-benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }

  .rb-benefit-item {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .rb-benefit-icon {
    flex-shrink: 0;
    color: #2d6a4f;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #e8f5e4;
    border-radius: 8px;
    width: 28px;
    height: 28px;
  }

  .rb-benefit-text {
    font-size: 12px;
    font-weight: 500;
    color: #1a3c2e;
    line-height: 1.3;
  }

  /* Progress bar */
  .rb-sold-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  .rb-progress-track {
    flex: 1;
    height: 10px;
    background: #dceedd;
    border-radius: 999px;
    overflow: hidden;
  }

.rb-progress-fill {
  height: 100%;
  width: 0%;
  background-color: #4a7c59 !important;
  background: #4a7c59 !important;
  border-radius: 999px;
}

/*
@keyframes rb-blink {
  0%   { opacity: 1; }
  50%  { opacity: 0.45; }
  100% { opacity: 1; }
}

.rb-progress-fill.rb-blink {
  animation: rb-blink 1.2s ease-in-out infinite;
}
*/


  .rb-sold-label {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
    color: #1a3c2e;
    white-space: nowrap;
  }

  .rb-sold-pct {
    color: #2d6a4f;
  }

  @media (max-width: 480px) {
    .rb-benefits-grid {
      grid-template-columns: 1fr 1fr;  /* Keep 2 columns on mobile */
      gap: 8px 10px; /* Slightly tighter gap for small screens */
    }
    .rb-benefits-wrap {
      padding: 14px 16px 14px;
    }
  }

  .rb-tm {
    top: -4px
    font-size: 12px
}
</style>

<script>
(function () {
  var TARGET_PCT = 94;
  var DURATION_MS = 5000;

  function animateBar() {
    var fill = document.getElementById('rb-progress-fill');
    var label = document.getElementById('rb-sold-pct');
    if (!fill || !label) return;

    // Ensure starting state is painted at 0 before we begin
    fill.style.width = '0%';
    label.textContent = '0%';

    var startTime = null;

    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      var elapsed = timestamp - startTime;
      var raw = Math.min(elapsed / DURATION_MS, 1);

      // Ease out cubic — smooth deceleration
      var eased = 1 - Math.pow(1 - raw, 3);
      var current = Math.round(eased * TARGET_PCT);

      // Directly set width and label every frame
      fill.style.width = current + '%';
      label.textContent = current + '%';

      if (raw < 1) {
        requestAnimationFrame(step);
      } else {
        // Fully reached 94% — lock width inline, then start blink
        fill.style.width = TARGET_PCT + '%';
        label.textContent = TARGET_PCT + '%';
        setTimeout(function () {
          fill.classList.add('rb-blink');
        }, 150);
      }
    }

    // Small delay so browser paints the 0% state first
    setTimeout(function () {
      requestAnimationFrame(step);
    }, 300);
  }

  // Only trigger when section scrolls into view
  var wrap = document.getElementById('rb-benefits-wrap');
  if (!wrap) return;

  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          animateBar();
          observer.disconnect();
        }
      });
    }, { threshold: 0.3 });
    observer.observe(wrap);
  } else {
    animateBar();
  }
})();
</script>
