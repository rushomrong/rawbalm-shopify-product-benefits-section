{% comment %}
  Timeline Section - Rusho
  Matches the wellness journey design with scroll-activated color fill
{% endcomment %}

<section class="timeline-section-rusho" id="tl-{{ section.id }}">
  <div class="page-width-rusho">
    <div class="journey-container-rusho journey-layout-rusho--{{ section.settings.layout_position }}">

      {%- comment -%} Info Panel (Left/Right/Top) {%- endcomment -%}
      <div class="content-column-rusho">
        {%- if section.settings.brand_image != blank -%}
          <img
            src="{{ section.settings.brand_image | image_url: width: 500 }}"
            alt="{{ section.settings.brand_image.alt | escape }}"
            loading="lazy"
            class="brand-image-rusho"
          />
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <h3 class="highlight-text-rusho">{{ section.settings.subtitle }}</h3>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="main-heading-rusho">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="description-text-rusho">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url }}" class="journey-button-rusho">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.guarantee_text != blank -%}
          <p class="prdoff-cta-note-rusho">
            {%- if section.settings.guarantee_icon != blank -%}
              <img
                src="{{ section.settings.guarantee_icon | image_url: width: 100 }}"
                alt="guarantee"
                loading="lazy"
              />
            {%- endif -%}
            {{ section.settings.guarantee_text }}
          </p>
        {%- endif -%}

        {%- comment -%} Mobile CTA (hidden on desktop, shows only on mobile) {%- endcomment -%}
        <div class="action-callout-rusho hide-desk">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_url }}" class="cta-button-rusho">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Timeline Column (milestones) {%- endcomment -%}
      <div class="timeline-column-rusho" id="tl-col-{{ section.id }}">
        <div class="milestones-container-rusho" id="tl-milestones-{{ section.id }}">

          {%- for block in section.blocks -%}
            {%- if block.type == 'milestone_item' -%}
              <div
                class="milestone-item-rusho"
                id="tl-milestone-{{ section.id }}-{{ forloop.index0 }}"
                data-milestone-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <span class="timeline-dot-rusho" id="tl-dot-{{ section.id }}-{{ forloop.index0 }}"></span>
                <span class="timeline-line-segment-rusho"></span>
                <span class="timeline-line-progress-rusho" id="tl-progress-{{ section.id }}-{{ forloop.index0 }}"></span>

                <div class="week-label-rusho" id="tl-label-{{ section.id }}-{{ forloop.index0 }}">
                  {{ block.settings.step_title }}
                </div>

                <div class="bullet-list-rusho">
                  <ul>
                    {%- if block.settings.item_1 != blank -%}
                      <li>{{ block.settings.item_1 }}</li>
                    {%- endif -%}
                    {%- if block.settings.item_2 != blank -%}
                      <li>{{ block.settings.item_2 }}</li>
                    {%- endif -%}
                    {%- if block.settings.item_3 != blank -%}
                      <li>{{ block.settings.item_3 }}</li>
                    {%- endif -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ============================================
     TIMELINE SECTION - RUSHO
  ============================================ */

  .timeline-section-rusho {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
