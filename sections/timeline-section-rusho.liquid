      color: var(--Secondary-Black, #000);
      text-align: center;
      font-family: Satoshi, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14px;
      font-style: normal;
      font-weight: 400;
      line-height: 120%;
    }

    .highlight-text-rusho {
      color: rgba(0, 147, 112, 1);
    }

    .journey-button-rusho {
      display: none !important;
    }

    .prdoff-cta-note-rusho {
      display: none !important;
    }

    .hide-mob {
      display: none !important;
    }

    .timeline-column-rusho {
      max-width: 100%;
      width: 100%;
    }

    .milestones-container-rusho {
      gap: 6px;
    }

    .week-label-rusho {
      padding: 9px 27px;
      border-radius: 5px;
      margin-bottom: 15px;
      height: 35px;
      color: #FFF;
      font-family: "Clash Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14px;
      font-style: normal;
      font-weight: 500;
      line-height: 120%;
    }

    .bullet-list-rusho li {
      margin-bottom: 14px;
      color: var(--Secondary-Black, #000);
      font-family: Satoshi, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14px;
      font-style: normal;
      font-weight: 400;
      line-height: 120%;
      padding-left: 19px;
    }

    .bullet-list-rusho li:before {
      width: 14px;
      height: 14px;
      left: 0;
      top: 1px;
      background-size: contain;
    }
@media (max-width: 991px) {
    .action-callout-rusho.hide-desk {
      display: none !important;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      margin-top: 15px;
    }
}    

    .action-callout-rusho.hide-desk .cta-button-rusho {
      color: #FFF;
      text-align: center;
      font-family: "Clash Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 16px !important;
      font-style: normal;
      font-weight: 500;
      line-height: 120%;
      letter-spacing: 0;
    }
  }

  /* Link default styling */
  a:not(:hover) {
    text-decoration: none;
  }
</style>

<script>
(function () {
  var sectionId = '{{ section.id }}';
  var milestonesContainer = document.getElementById('tl-milestones-' + sectionId);
  var timelineCol = document.getElementById('tl-col-' + sectionId);

  if (!milestonesContainer) return;

  var milestones = Array.from(milestonesContainer.querySelectorAll('.milestone-item-rusho'));
  var dots = milestones.map(function (m) { return m.querySelector('.timeline-dot-rusho'); });
  var labels = milestones.map(function (m) { return m.querySelector('.week-label-rusho'); });
  var progresses = milestones.map(function (m) { return m.querySelector('.timeline-line-progress-rusho'); });

  function onScroll() {
    var wh = window.innerHeight;

    milestones.forEach(function (milestone, i) {
      var rect = milestone.getBoundingClientRect();
      var midpoint = rect.top + rect.height / 2;

      // Trigger when milestone reaches 75% down the viewport
      var trigger = wh * 0.75;
      var isActive = midpoint <= trigger;

      if (isActive) {
        milestone.classList.add('milestone-active-rusho');
      } else {
        milestone.classList.remove('milestone-active-rusho');
      }
    });

    // Fill progress bars based on scroll position
    milestones.forEach(function (milestone, i) {
      if (!progresses[i]) return;

      var rect = milestone.getBoundingClientRect();
      var nextMilestone = milestones[i + 1];

      if (!nextMilestone) {
        // Last milestone — fill fully if active
        if (milestone.classList.contains('milestone-active-rusho')) {
          progresses[i].style.height = '103%';
        } else {
          progresses[i].style.height = '0';
        }
        return;
      }

      var nextRect = nextMilestone.getBoundingClientRect();
      var currentMid = rect.top + rect.height / 2;
      var nextMid = nextRect.top + nextRect.height / 2;
      var distance = nextMid - currentMid;

      var trigger = wh * 0.75;
      var fillHeight = 0;

      if (trigger >= nextMid) {
        // Both past trigger — fully filled
        fillHeight = 103;
      } else if (trigger > currentMid) {
        // Partially filled
        fillHeight = ((trigger - currentMid) / distance) * 100;
      }

      progresses[i].style.height = fillHeight + '%';
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>

