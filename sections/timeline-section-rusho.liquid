  .page-width-rusho {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .page-width-rusho {
      padding: 0 5rem;
    }
  }

  /* ---- Layout positioning ---- */
  .journey-container-rusho {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  /* Left: content on left, timeline on right (default) */
  .journey-layout-rusho--left {
    flex-direction: row;
  }

  /* Right: timeline on left, content on right */
  .journey-layout-rusho--right {
    flex-direction: row-reverse;
  }

  /* Top: content on top, timeline below */
  .journey-layout-rusho--top {
    flex-direction: column;
    align-items: center;
  }

  .journey-layout-rusho--top .content-column-rusho {
    width: 100%;
    margin-bottom: 40px;
  }

  .journey-layout-rusho--top .timeline-column-rusho {
    width: 100%;
    max-width: 600px;
  }

  /* ---- Content column (left/right/top) ---- */
  .content-column-rusho {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 50%;
    flex-shrink: 0;
  }

  .journey-layout-rusho--top .content-column-rusho {
    width: 100%;
  }

  @media (min-width: 992px) {
    .content-column-rusho {
      position: sticky;
      top: 70px;
    }
  }

  .brand-image-rusho {
    width: 100%;
    max-width: 450px;
    margin-bottom: 30px;
    display: block;
    border-radius: 8px;
  }

  /* Hide-desk and hide-mob utilities */
  .hide-desk {
    display: block !important;
  }

  .hide-mob {
    display: block !important;
  }

  .highlight-text-rusho {
    color: rgba(0, 147, 112, 1);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 8px;
    letter-spacing: 0.5px;
  }

  .main-heading-rusho {
    font-size: 2.4rem;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.3;
    font-family: "Clash Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .description-text-rusho {
    max-width: 467px;
    margin-left: auto;
    color: var(--Secondary-Black, #000);
    text-align: center;
    font-family: Satoshi, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: 29px;
    margin-right: auto;
    margin-top: 0;
    margin-bottom: 40px;
  }

  .journey-button-rusho {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 20px;
    font-weight: 500;
    padding: 12px 32px;
    border-radius: 6.94px;
    text-decoration: none;
    margin-bottom: 20px;
    transition: background-color 0.3s ease;
    height: 62.4px;
    max-width: 385px;
    width: 100%;
    font-family: "Clash Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    text-align: center;
  }

  .journey-button-rusho:hover {
    opacity: 0.88;
    color: {{ section.settings.button_text_color }};
  }

  .prdoff-cta-note-rusho {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.6rem;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .action-callout-rusho {
    display: none;
    margin-top: 50px;
    text-align: center;
  }

  .action-callout-rusho.hide-desk {
    display: none !important;
    margin-top: 50px;
  }

  .cta-button-rusho {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 20px;
    font-weight: 500;
    padding: 12px 32px;
    border-radius: 6.94px;
    text-decoration: none;
    height: 62.4px;
    max-width: 385px;
    width: 100%;
    font-family: "Clash Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    text-align: center;
    transition: background-color 0.3s ease;
    margin-bottom: 20px;
  }

  .cta-button-rusho:hover {
    opacity: 0.88;
    color: {{ section.settings.button_text_color }};
  }

  .cta-note-rusho {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .prdoff-cta-note-rusho img {
    max-width: 17px;
    height: auto;
  }

  p.cta-note-rusho img {
    max-width: 14px;
  }

  /* ---- Timeline column ---- */
  .timeline-column-rusho {
    position: relative;
    width: 50%;
  }

  .journey-layout-rusho--top .timeline-column-rusho {
    width: 100%;
  }

  .milestones-container-rusho {
    display: flex;
    flex-direction: column;
    gap: 17px;
  }

  /* ---- Single milestone item ---- */
  .milestone-item-rusho {
    position: relative;
    padding-left: 32px;
  }

  /* Timeline dot */
  .timeline-dot-rusho {
    position: absolute;
    left: 0;
    top: 6px;
    width: 16.65px;
    height: 16.65px;
    border-radius: 50%;
    background: {{ section.settings.line_default_color }};
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  /* Active state (set by JS on scroll) */
  .milestone-item-rusho.milestone-active-rusho .timeline-dot-rusho {
    background: {{ section.settings.line_active_color }};
  }

  /* Black line segment (background line) */
  .timeline-line-segment-rusho {
    position: absolute;
    left: 8px;
    top: 22px;
    pointer-events: none;
    height: 100%;
    width: 1.39px;
    background: {{ section.settings.line_default_color }};
  }

  /* Green progress fill (overlays the black line) */
  .timeline-line-progress-rusho {
    position: absolute;
    left: 6px;
    top: 22px;
    width: 4px;
    pointer-events: none;
    height: 0;
    background: {{ section.settings.line_active_color }};
    z-index: 1;
    transition: height 0.15s linear;
  }

  /* Label (header bar — black by default, green when active) */
  .week-label-rusho {
    padding: 4px 37px;
    border-radius: 6.94px;
    color: white;
    margin-bottom: 20px;
    transition: background-color 0.3s ease;
    background: {{ section.settings.line_default_color }};
    height: 48px;
    display: flex;
    align-items: center;
    font-family: "Clash Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17.278px;
    font-weight: 500;
    line-height: 24.98px;
    text-transform: capitalize;
  }

  .milestone-item-rusho.milestone-active-rusho .week-label-rusho {
    background: {{ section.settings.line_active_color }};
  }

  /* Bullet list */
  .bullet-list-rusho {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: {{ section.settings.text_color }};
  }

  .bullet-list-rusho ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bullet-list-rusho li {
